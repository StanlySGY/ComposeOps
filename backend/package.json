{
  "name": "composeops-backend",
  "version": "1.5.0",
  "description": "OpsDash backend - Docker Compose management API",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:agent-evals": "node --test --test-concurrency=1 test/agent-evals.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "rebuild": "cd node_modules/better-sqlite3 && npx --yes prebuild-install"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "better-sqlite3": "^13.0.3",
    "dockerode": "^5.0.1",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.11",
    "ssh2": "^1.17.0",
    "tar-stream": "^3.2.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.12.0"
  }
}
