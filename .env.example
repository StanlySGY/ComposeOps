ADMIN_PASSWORD=
DB_PATH=
DOCKER_HOST=
ENABLE_SHELL=
HOST=
LOG_LEVEL=
METRICS_INTERVAL_SECONDS=
SERVE_FRONTEND=
# 0 = 不信任转发头（默认）；1 = 信任入口代理；也可填写逗号分隔的可信代理 IP/CIDR
TRUST_PROXY=0
PORT=3000
GEMINI_API_KEY=
# 跨域嵌入模式:允许被任意页面 iframe、放开跨源 WebSocket、Cookie 用 SameSite=None; Secure; Partitioned。
# 会显著放宽安全约束(点击劫持/CSRF 面),仅当面板部署在另有网络隔离的环境且确实要被跨源嵌入时设 1。
# 同源部署(含反向代理)保持留空即可;HTTP 部署下该开关不生效(Cookie 退回 Lax 保证登录可用)。
EMBED_MODE=

# 受控 Effect Worker（目前仅低风险只读 Docker 检查）；设为 0 可暂停派发。
COMPOSEOPS_EFFECT_WORKER_ENABLED=1
